<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameDir Condition="'$(GameDir)' == ''">D:\Steam\steamapps\common\Slay the Spire 2</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <EmbeddedResource Include="signature.png" LogicalName="AspectWindow.signature.png" />
    <Reference Include="sts2"><HintPath>$(GameDir)\data_sts2_windows_x86_64\sts2.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GodotSharp"><HintPath>$(GameDir)\data_sts2_windows_x86_64\GodotSharp.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
